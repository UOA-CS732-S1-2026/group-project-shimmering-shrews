generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model awarded_badge {
  user_id   Int
  badge_id  Int
  earned_at DateTime @default(dbgenerated("(now() AT TIME ZONE 'nzt'::text)")) @db.Timestamptz(6)
  badge     badge    @relation(fields: [badge_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ab_badge")
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ab_user")

  @@id([user_id, badge_id])
}

model badge {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(100)
  description    String?          @db.VarChar(100)
  active_url     String?          @db.VarChar(500)
  inactive_url   String?          @db.VarChar(500)
  awarded_badge  awarded_badge[]
  badge_criteria badge_criteria[]
}

model challenge {
  id                 Int                @id @default(autoincrement())
  name               String             @db.VarChar(500)
  location_id        Int
  category_id        Int
  xp_worth           Int                @default(0)
  is_active          Boolean            @default(true)
  created_at         DateTime           @default(now()) @db.Timestamp(6)
  description        String?            @db.VarChar(1000)
  challenge_category challenge_category @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_challenge_category")
  location           location           @relation(fields: [location_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_challenge_location")
  user_challenge     user_challenge[]
}

model challenge_category {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(100)
  icon           String?          @db.VarChar(500)
  badge_criteria badge_criteria[]
  challenge      challenge[]
  user_stat      user_stat[]
}

model location {
  id        Int         @id @default(autoincrement())
  name      String      @db.VarChar(500)
  category  String?     @db.VarChar(250)
  latitude  Decimal     @db.Decimal(9, 6)
  longitude Decimal     @db.Decimal(9, 6)
  challenge challenge[]
}

model user_challenge {
  id            Int              @id @default(autoincrement())
  user_id       Int
  challenge_id  Int
  status        challenge_status
  xp_worth      Int
  assigned_at   DateTime         @default(now()) @db.Timestamp(6)
  accepted_at   DateTime?        @db.Timestamp(6)
  accepted_from_lat Decimal?     @db.Decimal(9, 6)
  accepted_from_lng Decimal?     @db.Decimal(9, 6)
  completed_at  DateTime?        @db.Timestamp(6)
  cancelled_at  DateTime?        @db.Timestamp(6)
  expired_at    DateTime?        @db.Timestamp(6)
  skipped_at    DateTime?        @db.Timestamp(6)
  challenge     challenge        @relation(fields: [challenge_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_uc_challenge")
  users         users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_uc_user")

  @@unique([user_id, challenge_id, assigned_at])
}

model users {
  id                       Int              @id @default(autoincrement())
  username                 String           @unique @db.VarChar(100)
  email                    String           @unique @db.VarChar(250)
  user_role                user_role
  created_at               DateTime         @default(now()) @db.Timestamp(6)
  updated_at               DateTime         @default(now()) @db.Timestamp(6)
  last_completed_challenge DateTime?        @db.Timestamp(6)
  level                    Int              @default(1)
  xp_earned                Int              @default(0)
  streak_count             Int              @default(0)
  auth_id                  String           @unique
  awarded_badge            awarded_badge[]
  user_challenge           user_challenge[]
  user_stat                user_stat[]
}

model badge_criteria {
  id                 Int                @id @default(autoincrement())
  badge_id           Int
  stat_name          String             @db.VarChar(100)
  category_id        Int                @default(0)
  target_value       Int
  badge              badge              @relation(fields: [badge_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  challenge_category challenge_category @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([badge_id, category_id, stat_name], map: "badge_criteria_unique")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user_stat {
  id                 Int                @id @default(autoincrement())
  user_id            Int
  category_id        Int
  current_value      Int                @default(0)
  name               String             @db.VarChar(100)
  updated_at         DateTime           @default(now()) @db.Timestamptz(6)
  challenge_category challenge_category @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_us_category")
  users              users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_us_user")

  @@unique([user_id, name, category_id], map: "user_stat_unique")
}

enum challenge_status {
  in_progress
  accepted
  cancelled
  skipped
  completed
  accepted
  cancelled
  expired
  expired
}

enum user_role {
  user
  admin
}
